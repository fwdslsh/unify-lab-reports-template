# Basic site. Unset public settings use site.config.json.
SITE_BRAND="My lab"
SITE_TITLE="My lab reports"
SITE_HOME_LABEL="My lab dashboard home"
SITE_FOOTER_TEXT="Private lab reports"
SITE_FILES_URL=""
REPORTS_TIMEZONE="UTC"
REPORTS_WEEKLY_KEEP=2

# Optional collection. Host lists and backup policy belong in lab.json.
LAB_COLLECT=false
LAB_CONFIG=lab.json
LAB_SNAPSHOT=state/observed.json
LAB_COLLECT_SECONDS=1800
# Optional native SSH files; never credential literals in public settings.
# LAB_SSH_KEY_FILE=/run/ssh/collect_key
# LAB_SSH_KNOWN_HOSTS=/run/ssh/known_hosts

# Docker Git publication: point at YOUR site's repo, not the template repo.
REPO_URL=https://git.example.net/team/my-lab-reports.git
BRANCH=main
BUILD_CONTEXT=..
STATE_PATH=../state
PUBLISH_PATH=../published
SSH_PATH=../ssh
LAB_CONFIG_PATH=../lab.json
PUBLISH_UID=1000
PUBLISH_GID=1000
# Optional: override when Compose is installed outside this checkout.
SITE_ENV_FILE=../.env
