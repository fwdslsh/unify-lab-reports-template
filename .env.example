# OPTIONAL Docker deployment only. Edit config.json for ALL site/lab settings.
REPO_URL=https://git.example.net/team/my-lab-reports.git
BRANCH=main
POLL_SECONDS=60
COLLECT=false
COLLECT_SECONDS=1800

# Optional native SSH files; no credentials belong in public config.json.
# SSH_KEY_FILE=/run/ssh/collect_key
# SSH_KNOWN_HOSTS_FILE=/run/ssh/known_hosts

# Defaults use the dedicated directories beside this project.
# STATE_PATH=../state
# PUBLISH_PATH=../published
# SSH_PATH=../ssh
# PUBLISH_UID=1000
# PUBLISH_GID=1000
